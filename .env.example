# ══════════════════════════════════════════════════════════════════
#  YaaParBot — contoh konfigurasi
#  Salin jadi .env lalu isi sesuai kebutuhan:  cp .env.example .env
#  Semua nilai di bawah masih placeholder — WAJIB diganti di produksi.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Guard engine: isi dengan id baris `bots` milik panel ini, supaya start/stop
# cuma menyentuh bot sendiri (kosongkan kalau panel ini satu-satunya pemakai
# tabel `bots`).
ENGINE_BOT_ID=

# ── Jalur lintas panel (engine/bridge.js) ─────────────────────────
# Panel labs boleh nge-Start bot platform ini lewat panelnya sendiri; perintahnya
# diteruskan ke sini dan log/QR-nya dibalikin ke panel labs. Kosongkan kalau
# panel ini berdiri sendiri (nggak ada panel lain yang nyuruh-nyuruh).
#   ENGINE_WEB_URL   = alamat panel labs (tujuan event log/QR)
#   BRIDGE_PLATFORM  = platform yang jadi wilayah engine ini
ENGINE_WEB_URL=http://127.0.0.1:3000
BRIDGE_PLATFORM=zapo

# ── JWT (ganti dengan string acak panjang!) ───────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
INTERNAL_KEY=your_internal_bearer_key_here_openssl_rand_hex_32

# ── MySQL ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=yaaparbot
# true = proses berhenti kalau DB gagal connect (disarankan di production)
DB_EXIT_ON_FAIL=false

# ── Sesi WhatsApp ─────────────────────────────────────────────────
SESSIONS_DIR=./sessions

# ── Default bot ───────────────────────────────────────────────────
DEFAULT_PREFIX=.
DEFAULT_FOOTER=Powered by YaaParBot
DESC_DEFAULT=Bot WhatsApp serbaguna powered by YaaParBot
MAX_SLOTS_PER_USER=2
DEFAULT_LIMIT=20
# Nomor developer (format 62xxx) — dapat akses owner otomatis
DEVELOPER_NUMBER=628xxxxxxxxxx
# Channel newsletter yang di-auto-follow bot
CH_DEV=120363xxxxxxxxxx@newsletter

# ── Pembayaran otomatis (QRISku) ───────────────────────────────────
# DUA baris ini WAJIB ada kalau `pay_mode` di /kountole bukan 'manual'.
# Tanpa keduanya, tombol bayar otomatis GAGAL dengan
#   [Billing] checkout error: QRISKU_API_KEY belum diisi
# dan user cuma melihat error di layar — pemilik tidak diberi tahu apa pun.
#
# QRISKU_API_KEY      = kunci dari dashboard QRISku (header X-API-Key)
# QRISKU_WEBHOOK_SECRET = secret buat memverifikasi tanda tangan webhook;
#                         tanpa ini webhook ditolak 401 dan paket tidak aktif.
#
# SESUDAH mengubah nilai di sini, restart WAJIB pakai --update-env:
#   pm2 restart jadibot --update-env
# PM2 menyimpan salinan environment saat start; `pm2 restart` biasa memakai
# salinan LAMA, jadi kuncinya kelihatan "sudah diisi" tapi kode tetap bilang
# belum diisi. `deploy.py` sudah memakai --update-env.
QRISKU_API_KEY=
QRISKU_WEBHOOK_SECRET=

# ── Aset default (path lokal atau URL; kosongkan untuk menonaktifkan) ──
QRIS_DEFAULT=assets/qris.jpg
BANNER_DEFAULT=assets/banner.jpg
# Banner gambar di header .menu (1 = nyala, 0 = mati).
MENU_BANNER=1
# Audio apa saja boleh (.mp3/.m4a/.wav/.ogg) — otomatis diubah jadi voice note ogg opus
AUDIO_DEFAULT=assets/audio.mp3

# ── Admin panel = role `kawula` (lihat config/roles.js) ───────────
# Akun ini dibuat otomatis saat pertama jalan. Kalau baris users dengan role
# `kawula` sudah ada, akun TIDAK dibuat ulang.
KING_USERNAME=admin
KING_PASSWORD=ganti_password_ini

# ── API YaaParBot (yapari.web.id) ─────────────────────────────────
BASE_API=https://yapari.web.id/
KEY_API=your_yapari_api_key

# ── AI (OpenAI-compatible endpoint) ───────────────────────────────
BASE_AI=https://modelnyaw.xyz/v1
KEY_AI=your_ai_api_key
MODEL_AI=auto

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGIN=https://labs.yapari.web.id

# ── Telegram (opsional, untuk gateway Telegram) ───────────────────
TELEGRAM_TOKEN=your_telegram_bot_token

# ── Branding ──────────────────────────────────────────────────────
STICKER_PACK_NAME="Jadibot? labs.yapari.web.id"
STICKER_AUTHOR="API? yapari.web.id"
FOOTER_TEXT="© 2026 yaparibotz - All Rights Reserved"

# ── Pesan bot (bisa diganti sesuai selera) ────────────────────────
MSG_LOADING="⏳ Tunggu sebentar..."
MSG_ERROR="Terjadi kesalahan, coba lagi nanti!"
MSG_INVALID_LINK="Link yang kamu masukkan tidak valid!"
MSG_CALL="Dilarang menelepon bot! Akses kamu akan terhambat."
MSG_TIMEOUT="Waktu permintaan telah habis (timeout)."
MSG_ONLY_GROUP="Fitur ini hanya dapat digunakan di dalam grup!"
MSG_ONLY_PM="Fitur ini hanya dapat digunakan di chat pribadi!"
MSG_ONLY_ADMIN="Fitur ini khusus untuk Admin grup!"
MSG_BOT_MUST_ADMIN="Jadikan bot sebagai Admin grup terlebih dahulu!"
MSG_ONLY_OWNER="Fitur ini khusus untuk Owner bot!"
MSG_LIMIT_EXCEEDED="Limit penggunaan kamu sudah habis!"
MSG_ONLY_PREMIUM="Fitur ini khusus untuk Member Premium!"
MSG_ONLY_SEWA="Grup ini belum menyewa bot!"

# ── Reaksi (emoji) ────────────────────────────────────────────────
REACT_LOADING=⏳
REACT_SUCCESS=✅
REACT_ERROR=❌

# ── Teks default template: welcome/bye + pengumuman jadwal buka-tutup ─────
# Dipakai otomatis kalau grup itu belum set lewat .setwelcome/.setbye/
# .setopen/.setclose. Kosongin = nggak kirim apa-apa.
# Placeholder: @user @namegc @desc @pesanan
#              @jam @menit @detik @hari @tanggal @bulan @tahun @namabulan
# Contoh: DEFAULT_SETCLOSE="Selamat tinggal, grup @namegc ditutup jam @jam WIB"
DEFAULT_SETOPEN=""
DEFAULT_SETCLOSE=""
DEFAULT_WELCOME="halo selamat datang @user di grup @namegc semoga betah yah 
@desc"
DEFAULT_SETBYE="babay beban @user dari grup @namegc"
# 1 = halaman /register boleh dipakai siapa saja; 0 = cuma admin
ALLOW_REGISTER=0

# ── Email (jalur kabar KETIGA) ────────────────────────────────────────────
# Kenapa perlu: notif WhatsApp dikirim LEWAT BOT MILIK USER SENDIRI (nomor
# owner & nomor HP, dua-duanya). Jadi saat botnya yang rusak — kuota habis,
# bot mati — kabarnya ikut hilang dan user tidak punya cara apa pun untuk tahu.
# Email tidak lewat bot.
#
# Dikirim lewat SMTP HTTP API (Resend / Brevo / Mailgun / SendGrid), pakai
# `axios` yang sudah jadi dependensi — TIDAK ada paket SMTP baru.
#
# Cara isi (contoh Resend, gratis 3.000 email/bulan):
#   1. Daftar di resend.com, verifikasi domain pengirim.
#   2. Buat API key.
#   3. Isi tiga baris di bawah.
#
# Kosong = email MATI (notif tetap jalan lewat WhatsApp). Saat email dipanggil
# dalam keadaan belum diisi, PM2 menulis SATU baris peringatan sekali per
# proses — sengaja, biar tidak gagal senyap.
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=
