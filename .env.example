# ══════════════════════════════════════════════════════════════════
#  YaaParBot — contoh konfigurasi
#  Salin jadi .env lalu isi sesuai kebutuhan:  cp .env.example .env
#  Semua nilai di bawah masih placeholder — WAJIB diganti di produksi.
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT (ganti dengan string acak panjang!) ───────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ── MySQL ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=yaaparbot
# true = proses berhenti kalau DB gagal connect (disarankan di production)
DB_EXIT_ON_FAIL=false

# ── Sesi WhatsApp ─────────────────────────────────────────────────
SESSIONS_DIR=./sessions

# ── Default bot ───────────────────────────────────────────────────
DEFAULT_PREFIX=.
DEFAULT_FOOTER=Powered by YaaParBot
DESC_DEFAULT=Bot WhatsApp serbaguna powered by YaaParBot
MAX_SLOTS_PER_USER=2
DEFAULT_LIMIT=20
# Nomor developer (format 62xxx) — dapat akses owner otomatis
DEVELOPER_NUMBER=628xxxxxxxxxx
# Channel newsletter yang di-auto-follow bot
CH_DEV=120363xxxxxxxxxx@newsletter

# ── Aset default (path lokal atau URL; kosongkan untuk menonaktifkan) ──
QRIS_DEFAULT=assets/qris.jpg
BANNER_DEFAULT=assets/banner.jpg
# Banner gambar di header .menu (1 = nyala, 0 = mati).
MENU_BANNER=1
# Audio apa saja boleh (.mp3/.m4a/.wav/.ogg) — otomatis diubah jadi voice note ogg opus
AUDIO_DEFAULT=assets/audio.mp3

# ── King (super admin) — dibuat otomatis saat pertama jalan ───────
KING_USERNAME=king
KING_PASSWORD=ganti_password_ini

# ── API YaaParBot (yapari.web.id) ─────────────────────────────────
BASE_API=https://yapari.web.id/
KEY_API=your_yapari_api_key

# ── AI (OpenAI-compatible endpoint) ───────────────────────────────
BASE_AI=https://modelnyaw.xyz/v1
KEY_AI=your_ai_api_key
MODEL_AI=auto

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGIN=https://labs.yapari.web.id

# ── Telegram (opsional, untuk gateway Telegram) ───────────────────
TELEGRAM_TOKEN=your_telegram_bot_token

# ── Branding ──────────────────────────────────────────────────────
STICKER_PACK_NAME="Jadibot? labs.yapari.web.id"
STICKER_AUTHOR="API? yapari.web.id"
FOOTER_TEXT="© 2026 yaparibotz - All Rights Reserved"

# ── Pesan bot (bisa diganti sesuai selera) ────────────────────────
MSG_LOADING="⏳ Tunggu sebentar..."
MSG_ERROR="Terjadi kesalahan, coba lagi nanti!"
MSG_INVALID_LINK="Link yang kamu masukkan tidak valid!"
MSG_CALL="Dilarang menelepon bot! Akses kamu akan terhambat."
MSG_TIMEOUT="Waktu permintaan telah habis (timeout)."
MSG_ONLY_GROUP="Fitur ini hanya dapat digunakan di dalam grup!"
MSG_ONLY_PM="Fitur ini hanya dapat digunakan di chat pribadi!"
MSG_ONLY_ADMIN="Fitur ini khusus untuk Admin grup!"
MSG_BOT_MUST_ADMIN="Jadikan bot sebagai Admin grup terlebih dahulu!"
MSG_ONLY_OWNER="Fitur ini khusus untuk Owner bot!"
MSG_LIMIT_EXCEEDED="Limit penggunaan kamu sudah habis!"
MSG_ONLY_PREMIUM="Fitur ini khusus untuk Member Premium!"
MSG_ONLY_SEWA="Grup ini belum menyewa bot!"

# ── Reaksi (emoji) ────────────────────────────────────────────────
REACT_LOADING=⏳
REACT_SUCCESS=✅
REACT_ERROR=❌

# ── Teks default template: welcome/bye + pengumuman jadwal buka-tutup ─────
# Dipakai otomatis kalau grup itu belum set lewat .setwelcome/.setbye/
# .setopen/.setclose. Kosongin = nggak kirim apa-apa.
# Placeholder: @user @usertag @subject @groupname @namegc @desc @pesanan
#              @jam @menit @detik @hari @tanggal @bulan @tahun @namabulan
# Contoh: DEFAULT_SETCLOSE="Selamat tinggal, grup @groupname ditutup jam @jam WIB"
DEFAULT_SETOPEN=""
DEFAULT_SETCLOSE=""
DEFAULT_WELCOME="halo selamat datang @user di grup @namegc semoga betah yah 
@desc"
DEFAULT_SETBYE="babay beban @user dari grup @namegc"
