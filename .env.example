# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=yaaparbot

# Sessions
SESSIONS_DIR=./sessions

# Bot Defaults
DEFAULT_PREFIX=!
DEFAULT_FOOTER=Powered by YaaParBot

# Gambar/audio default (path lokal atau URL). Kosongkan untuk menonaktifkan.
BANNER_DEFAULT=assets/banner.jpg
QRIS_DEFAULT=assets/qris.jpg
# .ogg (opus) → dikirim sebagai voice note, selain itu sebagai audio biasa
AUDIO_DEFAULT=assets/audio.ogg
MAX_SLOTS_PER_USER=2

# King (Super Admin) credentials - auto-created on first run
KING_USERNAME=king
KING_PASSWORD=king123

# Telegram Bot API (for Telegram gateway)
TELEGRAM_TOKEN=your_telegram_bot_token
